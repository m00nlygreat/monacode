{
  "name": "Monacode",
  "short_name": "Monacode",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#111827",
  "theme_color": "#111827",
  "icons": [
    {
      "src": "./icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "text/*": [".css", ".csv", ".html", ".js", ".json", ".md", ".ts", ".txt", ".xml", ".yaml", ".yml"]
      }
    }
  ]
}
